// Make or Break - Prisma schema
// ---------------------------------------------------------------------------
// This is the SINGLE SOURCE OF TRUTH for the platform data model. It is
// designed up front to cover all 8 build phases so later phases add behavior,
// not schema churn. Sections are annotated with the phase that first exercises
// them. In Phase 1 only a subset is used (auth, profile, modules, lessons,
// paths, progress); everything else is defined and migrated now so the model
// is stable.
//
// Conventions:
//   - cuid() primary keys everywhere (URL-safe, non-enumerable).
//   - Postgres scalar lists (String[]) for tags/objectives/etc.
//   - Denormalized "count" caches (ownsCount, upvoteCount, ...) are updated in
//     application logic and are advisory; the join tables are the source of truth.
//   - Content prose (lessons, machine guides, walkthroughs) lives in MDX files
//     referenced by `contentRef`; the DB stores structure + progress, not prose.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase transaction pooler, port 6543) for the app at
  // runtime; direct/session connection (port 5432) for migrations. On non-Supabase
  // hosts, set both to the same URL.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================================================================
// ENUMS
// ===========================================================================

enum Role {
  USER
  CREATOR
  ADMIN
}

enum SubscriptionTier {
  FREE
  PRO
  TEAM
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  NONE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  INSANE
}

enum MachineOS {
  LINUX
  WINDOWS
  ANDROID
  OTHER
}

// How a box's target is obtained. Phase A = DOCKER + BYO_VM (no hosting cost).
// Phase B = HOSTED (platform-provisioned, per-user isolated, VPN-reached).
enum TargetType {
  DOCKER
  BYO_VM
  HOSTED
}

enum FlagType {
  USER
  ROOT
}

// Lifecycle for authored content (lessons, machines) and the creator pipeline.
enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED
  RETIRED
}

enum WriteupStatus {
  DRAFT
  PUBLISHED
}

enum SubmissionResult {
  CORRECT
  INCORRECT
  DUPLICATE
  RATE_LIMITED
}

enum PathItemType {
  LESSON
  MACHINE
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum VoteValue {
  UP
  DOWN
}

enum NotificationType {
  FIRST_BLOOD
  FLAG_CAPTURED
  BADGE_EARNED
  FORUM_REPLY
  BEST_ANSWER
  TEAM_INVITE
  SUBMISSION_REVIEWED
  MACHINE_EXPIRING
  SYSTEM
}

enum MachineInstanceStatus {
  QUEUED
  PROVISIONING
  RUNNING
  EXPIRED
  TERMINATED
  FAILED
}

enum CompetitionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
}

enum ScoringType {
  STATIC
  DYNAMIC // points decay as more players solve
}

// ===========================================================================
// AUTH (Auth.js / NextAuth v5) - Phase 1
// Standard adapter models. Sessions are JWT-strategy (Credentials support),
// but Account/Session/VerificationToken are kept so OAuth + future DB sessions
// work without a migration.
// ===========================================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===========================================================================
// USER + PROFILE - Phase 1
// ===========================================================================

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  username       String    @unique
  name           String?
  image          String?
  hashedPassword String? // null for OAuth-only accounts
  emailVerified  DateTime?
  role           Role      @default(USER)

  // Gamification cache (source of truth = FlagSubmission / progress rows).
  points        Int       @default(0)
  rankTitle     String    @default("Newcomer")
  streakCount   Int       @default(0)
  longestStreak Int       @default(0)
  lastActiveOn  DateTime?

  // Billing cache (source of truth = Subscription).
  subscriptionTier SubscriptionTier @default(FREE)

  acceptedTermsAt DateTime? // rules-of-engagement / ToS acceptance
  onboardedAt     DateTime?
  bannedAt        DateTime?
  isGuest         Boolean   @default(false) // cookie-only account, no email/password yet
  signupIp        String? // client IP at guest creation, for per-IP abuse throttling

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accounts        Account[]
  sessions        Session[]
  profile         Profile?
  subscription    Subscription?
  lessonProgress  LessonProgress[]
  machineProgress MachineProgress[]
  pathProgress    PathProgress[]
  flagSubmissions FlagSubmission[]
  hintUnlocks     HintUnlock[]
  taskCompletions MachineTaskCompletion[]
  writeups        Writeup[]
  achievements    UserAchievement[]
  notifications   Notification[]
  forumThreads    ForumThread[]
  forumPosts      ForumPost[]
  comments        Comment[]
  votes           Vote[]
  communities     Community[]            @relation("CommunityCreator")
  communityMemberships CommunityMember[]
  auditLogs       AuditLog[]
  teamMemberships TeamMember[]
  ownedTeams      Team[]                    @relation("TeamOwner")
  createdMachines Machine[]                 @relation("MachineCreator")
  firstBloods     Machine[]                 @relation("MachineFirstBlood")
  createdLessons  Lesson[]                  @relation("LessonCreator")
  machineInstances MachineInstance[]
  vpnPeers        VpnPeer[]
  ctfParticipant  CompetitionParticipant[]
  ctfSolves       CompetitionSolve[]
  examAttempts    ExamAttempt[]
  challengeSolves ChallengeSolve[]
  dailyDropSolves DailyDropSolve[]
  authoredChallenges Challenge[]            @relation("ChallengeAuthor")
  challengeVotes  ChallengeVote[]
  challengeComments ChallengeComment[]      @relation("ChallengeCommenter")
  mentorLinks     MentorMatch[]             @relation("MentorLink")
  menteeLinks     MentorMatch[]             @relation("MenteeLink")
  following        Follow[]                 @relation("Following")
  followers        Follow[]                 @relation("Followers")
  sentMessages     DirectMessage[]          @relation("SentMessages")
  receivedMessages DirectMessage[]          @relation("ReceivedMessages")

  @@index([points])
  @@index([subscriptionTier])
  @@index([signupIp])
}

// One directed follow edge: follower -> following.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

// A one-to-one direct message. A conversation between two users is every row
// where {sender, recipient} matches that pair, ordered by createdAt.
model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String    @db.Text
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  sender    User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique
  bio         String? @db.Text
  avatarUrl   String?
  country     String?
  website     String?
  github      String?
  twitter     String?
  // Cached skill breakdown for the radar chart: { web: 120, network: 80, ... }
  skillPoints Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===========================================================================
// ACADEMY: MODULES + LESSONS + PATHS - Phase 2
// ===========================================================================

model Module {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  icon        String? // lucide icon name
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  lessons Lesson[]
}

model Lesson {
  id               String   @id @default(cuid())
  slug             String   @unique
  moduleId         String
  title            String
  summary          String?  @db.Text
  contentRef       String // path to MDX under content/lessons, e.g. "networking/subnetting"
  order            Int      @default(0)
  estimatedMinutes Int      @default(15)
  objectives       String[]
  prerequisites    String[] // lesson slugs
  tags             String[]
  status           ContentStatus @default(PUBLISHED)
  createdById      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module    Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("LessonCreator", fields: [createdById], references: [id])
  progress  LessonProgress[]
  pathItems PathItem[]

  @@index([moduleId])
  @@index([status])
}

model Path {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  description     String     @db.Text
  icon            String?
  difficulty      Difficulty @default(EASY)
  order           Int        @default(0)
  certificationId String? // set for certification-prep paths
  createdAt       DateTime   @default(now())

  certification Certification? @relation(fields: [certificationId], references: [id], onDelete: SetNull)
  items         PathItem[]
  progress      PathProgress[]
}

model PathItem {
  id        String       @id @default(cuid())
  pathId    String
  order     Int
  type      PathItemType
  lessonId  String?
  machineId String?

  path    Path     @relation(fields: [pathId], references: [id], onDelete: Cascade)
  lesson  Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  machine Machine? @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([pathId, order])
  @@index([pathId])
}

// ===========================================================================
// PRACTICE: MACHINES / BOXES - Phase 3 (targets) + Phase B (hosted)
// ===========================================================================

model Machine {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  tagline     String? // one-liner for cards
  description String     @db.Text
  contentRef  String // MDX under content/machines: overview, setup, tasks, walkthrough
  difficulty  Difficulty
  os          MachineOS  @default(LINUX)
  targetType  TargetType @default(DOCKER)
  tags        String[]
  points      Int        @default(20)
  status      ContentStatus @default(PUBLISHED)
  retired     Boolean    @default(false)
  releaseDate DateTime   @default(now())

  // Phase A - Docker target definition
  dockerImage    String?
  dockerRunCmd   String? @db.Text
  targetPort     Int?
  targetHttpPath String?

  // Phase A - Bring-your-own-VM (VulnHub) target definition
  byoVmName        String?
  byoVmSourceUrl   String?
  byoVmSha256      String?
  byoVmImportNotes String? @db.Text

  // Phase B - hosted orchestration hints
  hostedImage       String? // OCI image the controller provisions
  hostedCpuLimit    Float? // vCPU
  hostedMemLimitMb  Int?
  hostedTtlMinutes  Int     @default(120)

  // Caches
  ownsCount        Int      @default(0)
  ratingAvg        Float    @default(0)
  firstBloodUserId String?
  firstBloodAt     DateTime?
  creatorId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator        User?             @relation("MachineCreator", fields: [creatorId], references: [id])
  firstBloodUser User?             @relation("MachineFirstBlood", fields: [firstBloodUserId], references: [id])
  flags          Flag[]
  hints          Hint[]
  tasks          MachineTask[]
  submissions    FlagSubmission[]
  progress       MachineProgress[]
  writeups       Writeup[]
  comments       Comment[]
  forumThreads   ForumThread[]
  instances      MachineInstance[]
  pathItems      PathItem[]

  @@index([difficulty])
  @@index([os])
  @@index([status])
  @@index([retired])
}

model Flag {
  id            String   @id @default(cuid())
  machineId     String
  type          FlagType
  label         String
  // SHA-256 hex of the canonical flag string. Never store plaintext.
  hash          String
  points        Int      @default(10)
  // Phase B: when true, the flag is salted per user so a shared flag fails
  // for anyone but the owner. Validation then hashes(input+userSalt).
  perUserSalted Boolean  @default(false)

  machine     Machine          @relation(fields: [machineId], references: [id], onDelete: Cascade)
  submissions FlagSubmission[]

  @@unique([machineId, type])
  @@index([machineId])
}

model MachineTask {
  id          String  @id @default(cuid())
  machineId   String
  order       Int
  title       String
  description String? @db.Text

  machine     Machine                 @relation(fields: [machineId], references: [id], onDelete: Cascade)
  completions MachineTaskCompletion[]

  @@unique([machineId, order])
  @@index([machineId])
}

model MachineTaskCompletion {
  id          String   @id @default(cuid())
  taskId      String
  userId      String
  completedAt DateTime @default(now())

  task MachineTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

model Hint {
  id        String  @id @default(cuid())
  machineId String
  order     Int
  title     String?
  body      String  @db.Text
  pointCost Int     @default(0)

  machine Machine      @relation(fields: [machineId], references: [id], onDelete: Cascade)
  unlocks HintUnlock[]

  @@unique([machineId, order])
  @@index([machineId])
}

model HintUnlock {
  id         String   @id @default(cuid())
  userId     String
  hintId     String
  pointCost  Int      @default(0)
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  hint Hint @relation(fields: [hintId], references: [id], onDelete: Cascade)

  @@unique([userId, hintId])
  @@index([userId])
}

// ===========================================================================
// PROGRESS - Phase 2/3
// ===========================================================================

model LessonProgress {
  id            String    @id @default(cuid())
  userId        String
  lessonId      String
  completed     Boolean   @default(false)
  completedAt   DateTime?
  // Per-lesson interactive state: { quizzes: {...}, exercises: {...} }
  interactive   Json?
  notes         String?   @db.Text
  updatedAt     DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model MachineProgress {
  id              String    @id @default(cuid())
  userId          String
  machineId       String
  userOwned       Boolean   @default(false)
  rootOwned       Boolean   @default(false)
  userOwnedAt     DateTime?
  rootOwnedAt     DateTime?
  pointsEarned    Int       @default(0)
  startedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([userId, machineId])
  @@index([userId])
  @@index([machineId])
}

model PathProgress {
  id                 String   @id @default(cuid())
  userId             String
  pathId             String
  completedItemCount Int      @default(0)
  totalItemCount     Int      @default(0)
  completed          Boolean  @default(false)
  startedAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  path Path @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([userId, pathId])
  @@index([userId])
}

// ===========================================================================
// FLAG SUBMISSIONS + ANTI-CHEAT - Phase 3/4
// ===========================================================================

model FlagSubmission {
  id            String           @id @default(cuid())
  userId        String
  machineId     String
  flagId        String?
  submittedHash String // sha256 of the raw submission (never store plaintext)
  result        SubmissionResult
  isFirstBlood  Boolean          @default(false)
  pointsAwarded Int              @default(0)
  // Anti-cheat metadata
  ip            String?
  userAgent     String?          @db.Text
  createdAt     DateTime         @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  flag    Flag?   @relation(fields: [flagId], references: [id])

  @@index([userId])
  @@index([machineId])
  @@index([submittedHash]) // detect identical-submission (flag sharing) patterns
  @@index([createdAt])
}

// ===========================================================================
// WRITEUPS + COMMUNITY - Phase 5
// ===========================================================================

model Writeup {
  id          String        @id @default(cuid())
  userId      String
  machineId   String
  title       String
  contentMdx  String        @db.Text
  status      WriteupStatus @default(DRAFT)
  skillTags   String[]
  upvoteCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  machine  Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  comments Comment[]
  votes    Vote[]

  @@unique([userId, machineId])
  @@index([machineId])
  @@index([status])
}

model Comment {
  id        String   @id @default(cuid())
  authorId  String
  body      String   @db.Text
  writeupId String?
  machineId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  writeup Writeup? @relation(fields: [writeupId], references: [id], onDelete: Cascade)
  machine Machine? @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([writeupId])
  @@index([machineId])
}

model ForumThread {
  id          String    @id @default(cuid())
  title       String
  category    String    @default("general") // legacy; communityId is the source of truth now
  communityId String?
  authorId    String
  machineId   String? // null = general forum
  pinned      Boolean   @default(false)
  locked      Boolean   @default(false)
  postCount   Int       @default(0)
  lastPostAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  machine   Machine?    @relation(fields: [machineId], references: [id], onDelete: Cascade)
  community Community?  @relation(fields: [communityId], references: [id], onDelete: SetNull)
  posts     ForumPost[]
  votes     Vote[]

  @@index([machineId])
  @@index([category])
  @@index([communityId])
}

// A user-creatable community (like a subreddit). Threads belong to one.
model Community {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @db.Text
  icon        String   @default("Users") // LucideIcon name
  official    Boolean  @default(false) // seeded starter communities
  createdById String?
  memberCount Int      @default(0) // denormalized; CommunityMember is the source of truth
  threadCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?             @relation("CommunityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   CommunityMember[]
  threads   ForumThread[]

  @@index([slug])
}

model CommunityMember {
  id          String   @id @default(cuid())
  userId      String
  communityId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId])
}

model ForumPost {
  id           String   @id @default(cuid())
  threadId     String
  authorId     String
  body         String   @db.Text
  isBestAnswer Boolean  @default(false)
  parentPostId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author   User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   ForumPost?  @relation("PostReplies", fields: [parentPostId], references: [id])
  replies  ForumPost[] @relation("PostReplies")
  votes    Vote[]

  @@index([threadId])
  @@index([authorId])
}

model Vote {
  id            String    @id @default(cuid())
  userId        String
  value         VoteValue
  writeupId     String?
  forumThreadId String?
  forumPostId   String?
  createdAt     DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  writeup     Writeup?     @relation(fields: [writeupId], references: [id], onDelete: Cascade)
  forumThread ForumThread? @relation(fields: [forumThreadId], references: [id], onDelete: Cascade)
  forumPost   ForumPost?   @relation(fields: [forumPostId], references: [id], onDelete: Cascade)

  // A user may vote once per target (Postgres treats NULLs as distinct).
  @@unique([userId, writeupId])
  @@unique([userId, forumThreadId])
  @@unique([userId, forumPostId])
}

// ===========================================================================
// TEAMS + MENTORSHIP - Phase 5
// ===========================================================================

model Team {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  avatarUrl   String?
  ownerId     String
  points      Int      @default(0)
  createdAt   DateTime @default(now())

  owner   User         @relation("TeamOwner", fields: [ownerId], references: [id])
  members TeamMember[]

  @@index([points])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model MentorMatch {
  id        String   @id @default(cuid())
  mentorId  String
  menteeId  String
  status    String   @default("pending") // pending | active | ended
  createdAt DateTime @default(now())

  mentor User @relation("MentorLink", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee User @relation("MenteeLink", fields: [menteeId], references: [id], onDelete: Cascade)

  @@unique([mentorId, menteeId])
}

// ===========================================================================
// ACHIEVEMENTS - Phase 4
// ===========================================================================

model Achievement {
  id          String  @id @default(cuid())
  code        String  @unique // e.g. "first_blood", "own_10", "streak_7"
  name        String
  description String
  icon        String? // lucide icon name
  category    String  @default("general")
  points      Int     @default(0)

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

// ===========================================================================
// CTF / COMPETITIONS - Phase 7
// ===========================================================================

model Competition {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  description String            @db.Text
  startsAt    DateTime
  endsAt      DateTime
  status      CompetitionStatus @default(SCHEDULED)
  scoringType ScoringType       @default(DYNAMIC)
  isTeamBased Boolean           @default(false)
  createdAt   DateTime          @default(now())

  challenges   CompetitionChallenge[]
  participants CompetitionParticipant[]
  solves       CompetitionSolve[]
}

model CompetitionChallenge {
  id            String @id @default(cuid())
  competitionId String
  title         String
  description   String @db.Text
  category      String
  flagHash      String
  basePoints    Int    @default(500)
  minPoints     Int    @default(100) // floor for dynamic scoring
  order         Int    @default(0)

  competition Competition        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  solves      CompetitionSolve[]

  @@index([competitionId])
}

model CompetitionParticipant {
  id            String   @id @default(cuid())
  competitionId String
  userId        String?
  teamId        String?
  score         Int      @default(0)
  joinedAt      DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
  @@index([competitionId])
}

model CompetitionSolve {
  id            String   @id @default(cuid())
  competitionId String
  challengeId   String
  userId        String?
  teamId        String?
  pointsAwarded Int      @default(0)
  isFirstBlood  Boolean  @default(false)
  solvedAt      DateTime @default(now())

  competition Competition          @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  challenge   CompetitionChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([competitionId])
}

// ===========================================================================
// BILLING - Phase 6
// ===========================================================================

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(NONE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===========================================================================
// NOTIFICATIONS + AUDIT - Phase 4/6
// ===========================================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?          @db.Text
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ===========================================================================
// PHASE B: HOSTED MACHINE ORCHESTRATION + VPN
// The orchestration service owns the lifecycle; the app reads/writes these
// rows and enqueues jobs. Defined now so Phase B needs no schema migration.
// ===========================================================================

model MachineInstance {
  id                   String                @id @default(cuid())
  userId               String
  machineId            String
  status               MachineInstanceStatus @default(QUEUED)
  targetIp             String?
  containerId          String?
  networkId            String? // per-user isolated network id
  wireguardPeerPubKey  String?
  expiresAt            DateTime?
  extendedCount        Int                   @default(0)
  errorMessage         String?               @db.Text
  createdAt            DateTime              @default(now())
  terminatedAt         DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([machineId])
  @@index([status])
}

model VpnPeer {
  id         String   @id @default(cuid())
  userId     String
  publicKey  String   @unique
  allowedIp  String // the /32 assigned to this peer inside the user's network
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===========================================================================
// CERTIFICATIONS / EXAM PRACTICE
// Cert metadata + domains come from content/certs/<slug>/cert.json; question
// banks from content/certs/<slug>/questions/*.json. The seed upserts them.
// ExamAttempt records a scored practice/timed run.
// ===========================================================================

model Certification {
  id            String   @id @default(cuid())
  slug          String   @unique
  code          String
  name          String
  vendor        String
  description   String   @db.Text
  passScore     Int      @default(75) // percent to pass
  examMinutes   Int      @default(90)
  questionCount Int      @default(90) // recommended full-exam length
  icon          String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  domains   ExamDomain[]
  questions ExamQuestion[]
  attempts  ExamAttempt[]
  paths     Path[]
}

model ExamDomain {
  id              String @id @default(cuid())
  certificationId String
  number          Int
  name            String
  weight          Int    @default(0) // percent of the exam

  certification Certification  @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  questions     ExamQuestion[]

  @@unique([certificationId, number])
}

model ExamQuestion {
  id              String     @id @default(cuid())
  certificationId String
  domainId        String?
  question        String     @db.Text
  options         String[]
  correct         Int[] // 0-based indices; supports multi-select
  explanation     String     @db.Text
  difficulty      Difficulty @default(MEDIUM)

  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  domain        ExamDomain?   @relation(fields: [domainId], references: [id], onDelete: SetNull)

  @@index([certificationId])
  @@index([domainId])
}

model ExamAttempt {
  id              String    @id @default(cuid())
  userId          String
  certificationId String
  mode            String    @default("practice") // practice | timed | domain
  score           Int       @default(0) // percent
  correctCount    Int       @default(0)
  totalCount      Int       @default(0)
  passed          Boolean   @default(false)
  domainBreakdown Json? // { "<domainName>": { correct, total } }
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([certificationId])
}

// ===========================================================================
// CHALLENGES (Make/Break LeetCode-style problems + CTF)
// Challenge content + the canonical answer live on disk in
// content/challenges/<slug>.mdx (answer never leaves the server). Only the
// per-user solve state is stored here. Slug references the file, so adding a
// challenge is a content deploy, not a migration.
// ===========================================================================

model ChallengeSolve {
  id           String    @id @default(cuid())
  userId       String
  slug         String // content/challenges/<slug>.mdx
  attempts     Int       @default(0)
  solved       Boolean   @default(false)
  solvedAt     DateTime?
  pointsEarned Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId])
  @@index([slug])
}

// One row per user per daily drop. dateKey is the UTC calendar day "YYYY-MM-DD".
// The streak is derived from consecutive solved dateKeys. slug records which
// challenge was that day's drop (the selection is deterministic from the date).
model DailyDropSolve {
  id        String    @id @default(cuid())
  userId    String
  dateKey   String // UTC "YYYY-MM-DD"
  slug      String // content/challenges/<slug>.mdx that was the drop that day
  attempts  Int       @default(0)
  solved    Boolean   @default(false)
  startedAt DateTime  @default(now())
  solvedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([userId])
  @@index([dateKey])
}

// Community-authored challenges. Official challenges live on disk; these are
// created by users through the app. The answer is stored ONLY as a salted hash
// (never plaintext), and the markdown body is rendered through the safe
// PostBody renderer, never the expression-enabled MDX pipeline. Solves are
// tracked by slug in ChallengeSolve, same as file challenges (slugs are unique
// across both sources).
model Challenge {
  id            String   @id @default(cuid())
  slug          String   @unique
  authorId      String?
  title         String
  summary       String   @db.Text
  track         String // "make" | "break"
  category      String
  difficulty    String // EASY | MEDIUM | HARD | INSANE
  points        Int      @default(50)
  body          String   @db.Text // markdown, rendered via PostBody (safe)
  starter       String?  @db.Text
  starterLang   String?
  answerHash    String // sha256 of the normalized answer (never plaintext)
  answerType    String   @default("text") // number | text | flag
  caseSensitive Boolean  @default(false)
  hints         String[]
  status        String   @default("PUBLISHED") // PUBLISHED | HIDDEN
  solveCount    Int      @default(0)
  upvoteCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author User?            @relation("ChallengeAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  votes  ChallengeVote[]

  @@index([status])
  @@index([authorId])
  @@index([track])
}

model ChallengeVote {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([challengeId])
}

// Discussion on a challenge. Keyed by slug (a string) so it works for both
// official (file) and community (DB) challenges. Body is user markdown, rendered
// through the safe PostBody renderer.
model ChallengeComment {
  id        String   @id @default(cuid())
  slug      String // content/challenges/<slug> or a DB challenge slug
  authorId  String?
  body      String   @db.Text
  createdAt DateTime @default(now())

  author User? @relation("ChallengeCommenter", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([slug])
}
