# =============================================================================
# Make or Break - environment reference
# Copy to .env and fill in. Only DATABASE_URL + AUTH_SECRET are required for
# Phase 1. Everything else is feature-gated and only needed for later phases.
# =============================================================================

# --- Required (Phase 1) ------------------------------------------------------
# Postgres (Supabase/Neon in prod, local postgres in dev).
# DATABASE_URL is what the app queries through. DIRECT_URL is what migrations
# use. On a plain postgres they are the same value. On Supabase, DATABASE_URL is
# the transaction pooler (port 6543, add ?pgbouncer=true) and DIRECT_URL is the
# session pooler (port 5432); the direct db.<ref>.supabase.co host is IPv6 only
# and is not reachable from Vercel.
DATABASE_URL="postgresql://USER@localhost:5432/makeorbreak_dev?schema=public"
DIRECT_URL="postgresql://USER@localhost:5432/makeorbreak_dev?schema=public"

# Auth.js v5. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
# Set true behind a proxy / on non-localhost so Auth.js trusts the host header.
AUTH_TRUST_HOST=true

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Make or Break"

# --- OAuth providers (optional, Phase 1) ------------------------------------
# If unset, the provider is simply not shown. Credentials (email+password)
# always works without any of these.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Redis / queues (Phase 4: leaderboards, rate limiting; Phase B: jobs) ----
REDIS_URL="redis://localhost:6379"

# --- Stripe (Phase 6: subscriptions) ----------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_TEAM_MONTHLY=""

# --- S3-compatible object storage (Phase 5: avatars, writeup images) --------
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="makeorbreak"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- AI tutor (Phase 7: Socratic hint assistant) ----------------------------
# Any OpenAI-compatible endpoint. Feature is disabled when unset.
AI_TUTOR_API_KEY=""
AI_TUTOR_BASE_URL="https://api.anthropic.com/v1"
AI_TUTOR_MODEL="claude-haiku-4-5-20251001"

# --- Orchestration controller (Phase B: hosted machines) --------------------
# The app talks to the controller over this signed channel; the controller
# owns Docker + WireGuard. See services/orchestrator/README.md.
ORCHESTRATOR_URL="http://localhost:4000"
ORCHESTRATOR_SHARED_SECRET=""
WIREGUARD_SERVER_PUBLIC_KEY=""
WIREGUARD_ENDPOINT="vpn.makeorbreak.example:51820"
