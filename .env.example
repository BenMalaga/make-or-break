# =============================================================================
# Make or Break - environment reference
# The app has no accounts and no database: content is MDX on disk and progress
# lives in the browser's localStorage. The only required values are the public
# app identity strings below.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Make or Break"

# --- Optional site lock ------------------------------------------------------
# While set, every request needs Basic auth (user "mob"). Leave unset for a
# public site.
# SITE_PASSWORD=""
